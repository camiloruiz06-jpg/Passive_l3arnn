---
import { client, urlFor } from '../lib/sanity'
import { site } from '../lib/config'
import Footer from '../components/Footer.astro'

const posts = await client.fetch(`
  *[_type == "post"] | order(publishedAt desc) {
    _id,
    title,
    slug,
    mainImage,
    category,
    excerpt,
    publishedAt
  }
`)

// Lista de categorías únicas que realmente tienen posts (para los filtros)
const categories: string[] = [
  ...new Set(posts.map((p: any) => p.category).filter(Boolean)),
] as string[]
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={site.description} />
    <title>{site.name} — Aprende Sin Darte Cuenta</title>
    <link rel="icon" href="/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header>
      <div class="header-inner">
        <img src="/logo.png" alt={site.name} class="logo-img" />
        <h1 class="logo-text">{site.name}</h1>
        <p class="tagline">{site.tagline}</p>
      </div>
    </header>

    <main>
      {posts.length === 0 ? (
        <div class="empty">
          <p>🚀 Próximamente Los Primeros Posts...</p>
        </div>
      ) : (
        <>
          {categories.length > 0 && (
            <div class="filters">
              <button class="filter-chip active" data-filter="all">Todos</button>
              {categories.map((cat) => (
                <button class="filter-chip" data-filter={cat}>{cat}</button>
              ))}
            </div>
          )}

          <div class="grid">
            {posts.map((post: any) => (
              <a
                href={`/post/${post.slug.current}`}
                class="card"
                data-category={post.category || ''}
              >
                {post.mainImage && (
                  <div class="card-image">
                    <img
                      src={urlFor(post.mainImage).width(600).height(400).url()}
                      alt={post.title}
                      loading="lazy"
                    />
                    {post.category && <span class="badge">{post.category}</span>}
                  </div>
                )}
                <div class="card-body">
                  <h2>{post.title}</h2>
                  {post.excerpt && <p>{post.excerpt}</p>}
                  <span class="read-more">Leer Más →</span>
                </div>
              </a>
            ))}
          </div>
        </>
      )}
    </main>

    <script is:inline>
      const chips = document.querySelectorAll('.filter-chip')
      const cards = document.querySelectorAll('.card')
      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          const filter = chip.getAttribute('data-filter')
          chips.forEach((c) => c.classList.remove('active'))
          chip.classList.add('active')
          cards.forEach((card) => {
            const cat = card.getAttribute('data-category')
            card.style.display = filter === 'all' || cat === filter ? 'flex' : 'none'
          })
        })
      })
    </script>

    <Footer />
  </body>
</html>

<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'Nunito', sans-serif;
    background: #fdf2f6;
    color: #2b3a67;
    min-height: 100vh;
  }

  header {
    background: linear-gradient(180deg, #8ecbf5 0%, #b9defa 45%, #f7cdda 80%, #fdf2f6 100%);
    padding: 3rem 1.5rem 3.5rem;
    text-align: center;
  }

  .header-inner {
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .logo-img {
    width: 130px;
    height: 130px;
    object-fit: cover;
    border-radius: 50%;
    border: 4px solid #fff;
    box-shadow: 0 8px 20px rgba(43, 58, 103, 0.22);
  }

  .logo-text {
    font-family: 'Fredoka', sans-serif;
    font-size: 2.5rem;
    font-weight: 700;
    color: #2b3a67;
    margin-top: 0.5rem;
    letter-spacing: -0.5px;
  }

  .tagline {
    color: #3d4f7c;
    font-size: 1.05rem;
    font-weight: 600;
    margin-top: 0.5rem;
    max-width: 480px;
  }

  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin-bottom: 2.5rem;
  }

  .filter-chip {
    font-family: 'Fredoka', sans-serif;
    font-size: 0.92rem;
    font-weight: 500;
    padding: 0.5rem 1.25rem;
    border-radius: 999px;
    border: 2px solid #e3d5dd;
    background: #fff;
    color: #5a6789;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .filter-chip:hover {
    border-color: #8ecbf5;
    color: #2b3a67;
  }

  .filter-chip.active {
    background: #8ecbf5;
    border-color: #8ecbf5;
    color: #fff;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.75rem;
  }

  .card {
    background: #fff;
    border-radius: 22px;
    overflow: hidden;
    border: 2px solid #f0e3ea;
    text-decoration: none;
    color: inherit;
    transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 16px rgba(43, 58, 103, 0.06);
  }

  .card:hover {
    transform: translateY(-6px);
    border-color: #8ecbf5;
    box-shadow: 0 14px 30px rgba(43, 58, 103, 0.14);
  }

  .card-image {
    position: relative;
    aspect-ratio: 3/2;
    overflow: hidden;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .card:hover .card-image img { transform: scale(1.06); }

  .badge {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    background: #f4849f;
    color: #fff;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    box-shadow: 0 2px 6px rgba(43, 58, 103, 0.18);
  }

  .card-body {
    padding: 1.35rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .card-body h2 {
    font-family: 'Fredoka', sans-serif;
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.35;
    color: #2b3a67;
    text-align: center;
  }

  .card-body p {
    font-size: 0.92rem;
    color: #5a6789;
    line-height: 1.6;
    flex: 1;
  }

  .read-more {
    font-size: 0.85rem;
    font-weight: 700;
    color: #4a9fe0;
    margin-top: 0.4rem;
  }

  .empty {
    text-align: center;
    padding: 6rem 2rem;
    color: #8a97b8;
    font-size: 1.3rem;
    font-family: 'Fredoka', sans-serif;
  }
</style>
