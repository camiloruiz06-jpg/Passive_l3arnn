---
import { client, urlFor } from '../../lib/sanity'
import { site, catColor } from '../../lib/config'
import Footer from '../../components/Footer.astro'

export async function getStaticPaths() {
  const posts = await client.fetch(`*[_type == "post"]{ slug }`)
  return posts.map((post: any) => ({
    params: { slug: post.slug.current },
  }))
}

const { slug } = Astro.params
const post = await client.fetch(`
  *[_type == "post" && slug.current == $slug][0] {
    title,
    mainImage,
    category,
    excerpt,
    body,
    publishedAt,
    funFact,
    sources,
    "plain": pt::text(body)
  }
`, { slug })

if (!post) return Astro.redirect('/404')

// Posts relacionados: misma categoría primero, si no, los más recientes
const related = await client.fetch(`
  *[_type == "post" && slug.current != $slug] | order(
    select(category == $cat => 0, 1), publishedAt desc
  )[0...3] {
    title, slug, mainImage, category
  }
`, { slug, cat: post.category || '' })

const formattedDate = post.publishedAt
  ? new Date(post.publishedAt).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })
  : null

// Tiempo de lectura aproximado
const words = (post.plain || '').trim().split(/\s+/).filter(Boolean).length
const readMinutes = Math.max(1, Math.ceil(words / 200))

const canonical = `${site.url}/post/${slug}`
const ogImage = post.mainImage
  ? urlFor(post.mainImage).width(1200).height(630).url()
  : `${site.url}/logo.png`

// Datos estructurados para Google (rich results)
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: post.excerpt || post.title,
  image: ogImage,
  datePublished: post.publishedAt,
  articleSection: post.category,
  author: { '@type': 'Organization', name: site.name },
  publisher: {
    '@type': 'Organization',
    name: site.name,
    logo: { '@type': 'ImageObject', url: `${site.url}/logo.png` },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
}
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={post.excerpt || post.title} />
    <title>{post.title} — {site.name}</title>
    <link rel="icon" href="/logo.png" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph (Facebook, WhatsApp, etc.) -->
    <meta property="og:type" content="article" />
    <meta property="og:title" content={post.title} />
    <meta property="og:description" content={post.excerpt || post.title} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={post.title} />
    <meta name="twitter:description" content={post.excerpt || post.title} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Datos estructurados para Google -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Manrope:wght@400;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <nav>
      <a href="/" class="back">
        <img src="/logo.png" alt={site.name} class="nav-logo" />
        <span>← Volver Al Inicio</span>
      </a>
    </nav>

    <article>
      {post.mainImage && (
        <div class="hero-image">
          <img
            src={urlFor(post.mainImage).width(1200).height(600).url()}
            alt={post.title}
          />
          {post.category && <span class="badge" style={`background:${catColor(post.category)}`}>{post.category}</span>}
        </div>
      )}

      <div class="content">
        <div class="meta-line">
          {formattedDate && <time class="date">{formattedDate}</time>}
          <span class="dot">·</span>
          <span class="date">📖 {readMinutes} min de lectura</span>
        </div>
        <h1>{post.title}</h1>
        {post.excerpt && <p class="excerpt">{post.excerpt}</p>}

        <div class="share">
          <span class="share-label">Compartir:</span>
          <a class="share-btn wsp" href={`https://wa.me/?text=${encodeURIComponent(post.title + ' ' + canonical)}`} target="_blank" rel="noopener" aria-label="Compartir en WhatsApp">WhatsApp</a>
          <a class="share-btn fb" href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(canonical)}`} target="_blank" rel="noopener" aria-label="Compartir en Facebook">Facebook</a>
          <a class="share-btn x" href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.title)}&url=${encodeURIComponent(canonical)}`} target="_blank" rel="noopener" aria-label="Compartir en X">X</a>
          <button class="share-btn copy" data-url={canonical}>Copiar link</button>
        </div>

        {post.funFact && (
          <div class="fun-fact">
            <span class="fun-fact-icon">💡</span>
            <p>{post.funFact}</p>
          </div>
        )}

        {post.body && post.body.map((block: any) => {
          if (block._type === 'block') {
            return <p class="body-text">{block.children?.map((child: any) => child.text).join('')}</p>
          }
          if (block._type === 'image' && block.asset) {
            return (
              <figure class="body-image">
                <img src={urlFor(block).width(900).url()} alt={block.alt || ''} loading="lazy" />
                {block.caption && <figcaption>{block.caption}</figcaption>}
              </figure>
            )
          }
          return null
        })}

        {post.sources && post.sources.length > 0 && (
          <div class="sources">
            <h3>Fuentes</h3>
            <ul>
              {post.sources.map((source: string) => (
                <li><a href={source} target="_blank" rel="noopener">{source}</a></li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </article>

    {related && related.length > 0 && (
      <section class="related">
        <h3>Sigue Leyendo</h3>
        <div class="related-grid">
          {related.map((r: any) => (
            <a href={`/post/${r.slug.current}`} class="related-card">
              {r.mainImage && (
                <img src={urlFor(r.mainImage).width(400).height(260).url()} alt={r.title} loading="lazy" />
              )}
              <div class="related-body">
                {r.category && <span class="mini-badge" style={`background:${catColor(r.category)}`}>{r.category}</span>}
                <h4>{r.title}</h4>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <script is:inline>
      const copyBtn = document.querySelector('.share-btn.copy')
      if (copyBtn) {
        copyBtn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(copyBtn.getAttribute('data-url'))
            const original = copyBtn.textContent
            copyBtn.textContent = '¡Copiado! ✓'
            setTimeout(() => (copyBtn.textContent = original), 2000)
          } catch (e) {}
        })
      }
    </script>

    <Footer />
  </body>
</html>

<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'Manrope', sans-serif;
    background: #fdf2f6;
    color: #2b3a67;
    min-height: 100vh;
  }

  nav {
    padding: 1rem 1.5rem;
    background: linear-gradient(180deg, #8ecbf5 0%, #b9defa 100%);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: #2b3a67;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 700;
    transition: opacity 0.2s;
  }

  .back:hover { opacity: 0.7; }

  .nav-logo { width: 38px; height: 38px; object-fit: cover; border-radius: 50%; border: 2px solid #fff; }

  .hero-image {
    position: relative;
    height: 420px;
    overflow: hidden;
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 640px) {
    .hero-image { height: 260px; }
  }

  .badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background: #f4849f;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.35rem 1rem;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    box-shadow: 0 2px 8px rgba(43, 58, 103, 0.2);
  }

  .content {
    max-width: 720px;
    margin: -3rem auto 0;
    padding: 2.5rem;
    background: #fff;
    border-radius: 24px;
    position: relative;
    box-shadow: 0 10px 30px rgba(43, 58, 103, 0.1);
  }

  .meta-line {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .meta-line .dot { color: #c9d2e6; }

  .date {
    font-size: 0.8rem;
    color: #8a97b8;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
  }

  /* Compartir */
  .share {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
    justify-content: center;
  }

  .share-label { font-size: 0.85rem; font-weight: 700; color: #8a97b8; }

  .share-btn {
    font-family: 'Manrope', sans-serif;
    font-size: 0.82rem;
    font-weight: 700;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    border: none;
    cursor: pointer;
    text-decoration: none;
    color: #fff;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }

  .share-btn:hover { transform: translateY(-2px); opacity: 0.92; }

  .share-btn.wsp { background: #25d366; }
  .share-btn.fb { background: #1877f2; }
  .share-btn.x { background: #111; }
  .share-btn.copy { background: #8ecbf5; color: #2b3a67; }

  h1 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 2.2rem;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 1.25rem;
    color: #2b3a67;
    text-align: center;
  }

  .date { text-align: center; }

  .excerpt {
    font-size: 1.15rem;
    color: #5a6789;
    line-height: 1.7;
    margin-bottom: 2rem;
    border-left: 4px solid #8ecbf5;
    padding-left: 1rem;
    font-weight: 600;
    text-align: justify;
  }

  .fun-fact {
    background: linear-gradient(135deg, #fdeef3 0%, #eaf5fd 100%);
    border: 2px solid #f7cdda;
    border-radius: 16px;
    padding: 1.5rem;
    margin-bottom: 2rem;
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .fun-fact-icon { font-size: 1.5rem; flex-shrink: 0; }

  .fun-fact p {
    color: #3d4f7c;
    line-height: 1.7;
    font-size: 1rem;
    font-weight: 600;
  }

  .body-text {
    font-size: 1.08rem;
    line-height: 1.85;
    color: #44506e;
    margin-bottom: 1.5rem;
    text-align: justify;
  }

  .fun-fact p { text-align: justify; }

  .body-image {
    margin: 2rem 0;
  }

  .body-image img {
    width: 100%;
    border-radius: 16px;
    display: block;
    box-shadow: 0 6px 18px rgba(43, 58, 103, 0.12);
  }

  .body-image figcaption {
    text-align: center;
    font-size: 0.85rem;
    color: #8a97b8;
    margin-top: 0.6rem;
    font-style: italic;
  }

  .sources {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 2px solid #f0e3ea;
  }

  .sources h3 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1rem;
    color: #8a97b8;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.75rem;
  }

  .sources ul { list-style: none; }

  .sources li { margin-bottom: 0.4rem; }

  .sources a {
    color: #4a9fe0;
    font-size: 0.88rem;
    text-decoration: none;
    word-break: break-all;
  }

  .sources a:hover { text-decoration: underline; }

  /* Posts relacionados */
  .related {
    max-width: 1000px;
    margin: 4rem auto 0;
    padding: 0 1.5rem;
  }

  .related h3 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.6rem;
    font-weight: 700;
    color: #2b3a67;
    text-align: center;
    margin-bottom: 1.75rem;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.5rem;
  }

  .related-card {
    background: #fff;
    border-radius: 18px;
    overflow: hidden;
    border: 2px solid #f0e3ea;
    text-decoration: none;
    color: inherit;
    box-shadow: 0 4px 16px rgba(43, 58, 103, 0.06);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .related-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 26px rgba(43, 58, 103, 0.14);
  }

  .related-card img {
    width: 100%;
    aspect-ratio: 3/2;
    object-fit: cover;
    display: block;
  }

  .related-body {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .mini-badge {
    align-self: flex-start;
    background: #8ecbf5;
    color: #fff;
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.2rem 0.7rem;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .related-body h4 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
    color: #2b3a67;
    text-align: center;
  }
</style>
