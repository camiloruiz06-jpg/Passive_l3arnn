---
import { client, urlFor } from '../../lib/sanity'

export async function getStaticPaths() {
  const posts = await client.fetch(`*[_type == "post"]{ slug }`)
  return posts.map((post: any) => ({
    params: { slug: post.slug.current },
  }))
}

const { slug } = Astro.params
const post = await client.fetch(`
  *[_type == "post" && slug.current == $slug][0] {
    title,
    mainImage,
    category,
    excerpt,
    body,
    publishedAt,
    funFact,
    sources
  }
`, { slug })

if (!post) return Astro.redirect('/404')

const formattedDate = post.publishedAt
  ? new Date(post.publishedAt).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })
  : null
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={post.excerpt || post.title} />
    <title>{post.title} — passive_l3arn</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <nav>
      <a href="/" class="back">← Volver al inicio</a>
    </nav>

    <article>
      {post.mainImage && (
        <div class="hero-image">
          <img
            src={urlFor(post.mainImage).width(1200).height(600).url()}
            alt={post.title}
          />
          {post.category && <span class="badge">{post.category}</span>}
        </div>
      )}

      <div class="content">
        {formattedDate && <time class="date">{formattedDate}</time>}
        <h1>{post.title}</h1>
        {post.excerpt && <p class="excerpt">{post.excerpt}</p>}

        {post.funFact && (
          <div class="fun-fact">
            <span class="fun-fact-icon">💡</span>
            <p>{post.funFact}</p>
          </div>
        )}

        {post.body && post.body.map((block: any) => {
          if (block._type === 'block') {
            return <p class="body-text">{block.children?.map((child: any) => child.text).join('')}</p>
          }
          return null
        })}

        {post.sources && post.sources.length > 0 && (
          <div class="sources">
            <h3>Fuentes</h3>
            <ul>
              {post.sources.map((source: string) => (
                <li><a href={source} target="_blank" rel="noopener">{source}</a></li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </article>

    <footer>
      <p>© 2025 passive_l3arn · <a href="/">Ver más curiosidades</a></p>
    </footer>
  </body>
</html>

<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'Inter', sans-serif;
    background: #0a0a0a;
    color: #f0f0f0;
    min-height: 100vh;
  }

  nav {
    padding: 1.25rem 1.5rem;
    background: #111;
    border-bottom: 1px solid #1a1a1a;
  }

  .back {
    color: #a78bfa;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    transition: color 0.2s;
  }

  .back:hover { color: #c4b5fd; }

  .hero-image {
    position: relative;
    max-height: 500px;
    overflow: hidden;
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background: #a78bfa;
    color: white;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.35rem 1rem;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .content {
    max-width: 760px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  .date {
    font-size: 0.8rem;
    color: #555;
    display: block;
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h1 {
    font-size: 2.25rem;
    font-weight: 900;
    line-height: 1.2;
    margin-bottom: 1.25rem;
    background: linear-gradient(90deg, #f0f0f0, #a78bfa);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .excerpt {
    font-size: 1.15rem;
    color: #aaa;
    line-height: 1.7;
    margin-bottom: 2rem;
    border-left: 3px solid #a78bfa;
    padding-left: 1rem;
  }

  .fun-fact {
    background: linear-gradient(135deg, #1a1a2e, #16213e);
    border: 1px solid #a78bfa44;
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 2rem;
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .fun-fact-icon { font-size: 1.5rem; flex-shrink: 0; }

  .fun-fact p {
    color: #c4b5fd;
    line-height: 1.7;
    font-size: 1rem;
  }

  .body-text {
    font-size: 1.05rem;
    line-height: 1.8;
    color: #ccc;
    margin-bottom: 1.5rem;
  }

  .sources {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid #222;
  }

  .sources h3 {
    font-size: 0.85rem;
    color: #555;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.75rem;
  }

  .sources ul { list-style: none; }

  .sources li { margin-bottom: 0.4rem; }

  .sources a {
    color: #60a5fa;
    font-size: 0.85rem;
    text-decoration: none;
  }

  .sources a:hover { text-decoration: underline; }

  footer {
    text-align: center;
    padding: 2rem;
    color: #444;
    font-size: 0.85rem;
    border-top: 1px solid #1a1a1a;
  }

  footer a { color: #a78bfa; text-decoration: none; }
</style>
