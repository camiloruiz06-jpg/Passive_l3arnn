---
import { client, urlFor } from '../../lib/sanity'
import { site } from '../../lib/config'
import Footer from '../../components/Footer.astro'

export async function getStaticPaths() {
  const posts = await client.fetch(`*[_type == "post"]{ slug }`)
  return posts.map((post: any) => ({
    params: { slug: post.slug.current },
  }))
}

const { slug } = Astro.params
const post = await client.fetch(`
  *[_type == "post" && slug.current == $slug][0] {
    title,
    mainImage,
    category,
    excerpt,
    body,
    publishedAt,
    funFact,
    sources
  }
`, { slug })

if (!post) return Astro.redirect('/404')

const formattedDate = post.publishedAt
  ? new Date(post.publishedAt).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })
  : null
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={post.excerpt || post.title} />
    <title>{post.title} — {site.name}</title>
    <link rel="icon" href="/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <nav>
      <a href="/" class="back">
        <img src="/logo.png" alt={site.name} class="nav-logo" />
        <span>← Volver Al Inicio</span>
      </a>
    </nav>

    <article>
      {post.mainImage && (
        <div class="hero-image">
          <img
            src={urlFor(post.mainImage).width(1200).height(600).url()}
            alt={post.title}
          />
          {post.category && <span class="badge">{post.category}</span>}
        </div>
      )}

      <div class="content">
        {formattedDate && <time class="date">{formattedDate}</time>}
        <h1>{post.title}</h1>
        {post.excerpt && <p class="excerpt">{post.excerpt}</p>}

        {post.funFact && (
          <div class="fun-fact">
            <span class="fun-fact-icon">💡</span>
            <p>{post.funFact}</p>
          </div>
        )}

        {post.body && post.body.map((block: any) => {
          if (block._type === 'block') {
            return <p class="body-text">{block.children?.map((child: any) => child.text).join('')}</p>
          }
          if (block._type === 'image' && block.asset) {
            return (
              <figure class="body-image">
                <img src={urlFor(block).width(900).url()} alt={block.alt || ''} loading="lazy" />
                {block.caption && <figcaption>{block.caption}</figcaption>}
              </figure>
            )
          }
          return null
        })}

        {post.sources && post.sources.length > 0 && (
          <div class="sources">
            <h3>Fuentes</h3>
            <ul>
              {post.sources.map((source: string) => (
                <li><a href={source} target="_blank" rel="noopener">{source}</a></li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </article>

    <Footer />
  </body>
</html>

<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'Nunito', sans-serif;
    background: #fdf2f6;
    color: #2b3a67;
    min-height: 100vh;
  }

  nav {
    padding: 1rem 1.5rem;
    background: linear-gradient(180deg, #8ecbf5 0%, #b9defa 100%);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: #2b3a67;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 700;
    transition: opacity 0.2s;
  }

  .back:hover { opacity: 0.7; }

  .nav-logo { width: 38px; height: 38px; object-fit: cover; border-radius: 50%; border: 2px solid #fff; }

  .hero-image {
    position: relative;
    height: 420px;
    overflow: hidden;
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 640px) {
    .hero-image { height: 260px; }
  }

  .badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background: #f4849f;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.35rem 1rem;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    box-shadow: 0 2px 8px rgba(43, 58, 103, 0.2);
  }

  .content {
    max-width: 720px;
    margin: -3rem auto 0;
    padding: 2.5rem;
    background: #fff;
    border-radius: 24px;
    position: relative;
    box-shadow: 0 10px 30px rgba(43, 58, 103, 0.1);
  }

  .date {
    font-size: 0.8rem;
    color: #8a97b8;
    display: block;
    margin-bottom: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
  }

  h1 {
    font-family: 'Fredoka', sans-serif;
    font-size: 2.2rem;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 1.25rem;
    color: #2b3a67;
    text-align: center;
  }

  .date { text-align: center; }

  .excerpt {
    font-size: 1.15rem;
    color: #5a6789;
    line-height: 1.7;
    margin-bottom: 2rem;
    border-left: 4px solid #8ecbf5;
    padding-left: 1rem;
    font-weight: 600;
    text-align: justify;
  }

  .fun-fact {
    background: linear-gradient(135deg, #fdeef3 0%, #eaf5fd 100%);
    border: 2px solid #f7cdda;
    border-radius: 16px;
    padding: 1.5rem;
    margin-bottom: 2rem;
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .fun-fact-icon { font-size: 1.5rem; flex-shrink: 0; }

  .fun-fact p {
    color: #3d4f7c;
    line-height: 1.7;
    font-size: 1rem;
    font-weight: 600;
  }

  .body-text {
    font-size: 1.08rem;
    line-height: 1.85;
    color: #44506e;
    margin-bottom: 1.5rem;
    text-align: justify;
  }

  .fun-fact p { text-align: justify; }

  .body-image {
    margin: 2rem 0;
  }

  .body-image img {
    width: 100%;
    border-radius: 16px;
    display: block;
    box-shadow: 0 6px 18px rgba(43, 58, 103, 0.12);
  }

  .body-image figcaption {
    text-align: center;
    font-size: 0.85rem;
    color: #8a97b8;
    margin-top: 0.6rem;
    font-style: italic;
  }

  .sources {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 2px solid #f0e3ea;
  }

  .sources h3 {
    font-family: 'Fredoka', sans-serif;
    font-size: 1rem;
    color: #8a97b8;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.75rem;
  }

  .sources ul { list-style: none; }

  .sources li { margin-bottom: 0.4rem; }

  .sources a {
    color: #4a9fe0;
    font-size: 0.88rem;
    text-decoration: none;
    word-break: break-all;
  }

  .sources a:hover { text-decoration: underline; }
</style>
