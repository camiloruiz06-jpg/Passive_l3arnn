---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <img src="/logo.png" alt={site.name} class="footer-logo" />
      <span class="footer-name">{site.name}</span>
    </div>

    <div class="socials">
      {socials.map((s) => (
        <a href={s.url} target="_blank" rel="noopener" aria-label={s.name} class="social-link">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
            <path d={icons[s.icon]} />
          </svg>
        </a>
      ))}
    </div>

    <p class="copyright">© 2026 {site.name} · Hecho Con 🧠 Y Curiosidad</p>
  </div>
</footer>

<style>
  .site-footer {
    background: linear-gradient(135deg, #2b3a67 0%, #1f2a4d 100%);
    color: #fff;
    padding: 3rem 1.5rem 2rem;
    margin-top: 4rem;
  }

  .footer-inner {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .footer-logo {
    width: 48px;
    height: 48px;
    object-fit: contain;
  }

  .footer-name {
    font-family: 'Fredoka', sans-serif;
    font-size: 1.4rem;
    font-weight: 600;
  }

  .socials {
    display: flex;
    gap: 1rem;
  }

  .social-link {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .social-link:hover {
    transform: translateY(-3px) scale(1.05);
    background: #f4b8c9;
    color: #2b3a67;
  }

  .copyright {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.65);
  }
</style>
